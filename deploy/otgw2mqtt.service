[Unit]
Description=otgw2mqtt: OpenTherm Gateway to MQTT
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=otgw2mqtt
Group=otgw2mqtt
# Access to the USB serial port (/dev/ttyUSB*) is granted to the dialout group
SupplementaryGroups=dialout
WorkingDirectory=/opt/otgw2mqtt
# Expects a virtual environment in /opt/otgw2mqtt/.venv with otgw2mqtt installed (see README, "As a systemd service")
ExecStart=/opt/otgw2mqtt/.venv/bin/otgw2mqtt --config /etc/otgw2mqtt/otgw2mqtt.yaml
# OTGW_MQTT_HOST, _USERNAME, _PASSWORD, ... (same format as .env, see .env.example)
EnvironmentFile=-/etc/otgw2mqtt/env
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
